{
  "expo": {
    "name": "SteadyChime",
    "slug": "SteadyChime",
    "version": "1.0.0",
    "scheme": "steadychime",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lemao81.steadychime"
    },
    "android": {
      "package": "com.lemao81.steadychime",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/soft_bell.wav",
            "./assets/sounds/boxing_bell.wav",
            "./assets/sounds/triangle_chime.wav",
            "./assets/sounds/jaw_harp.wav",
            "./assets/sounds/harmonic_guitar.wav",
            "./assets/sounds/boom_piano.wav"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
